-- Compiled with roblox-ts v3.0.0
local _jestGlobals = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("node_modules"):WaitForChild("@rbxts"):WaitForChild("jest-globals"):WaitForChild("src"))
local _binding = _jestGlobals
local describe = _binding.describe
local expect = _binding.expect
local it = _binding.it
-- Dynamically require client files to bypass roblox-ts isolated container checks
local robloxCSS = game:GetService("ReplicatedStorage"):WaitForChild("roblox-css")
local uiStyles = robloxCSS:WaitForChild("styles")
local gradientParserModule = require(uiStyles:WaitForChild("gradientParser"))
local parseGradient = gradientParserModule.parseGradient
local isGradientString = gradientParserModule.isGradientString
describe("gradientParser", function()
	it("isGradientString", function()
		expect(isGradientString("linear-gradient(to right, red, blue)")).toBe(true)
		expect(isGradientString("not-a-gradient")).toBe(false)
	end)
	it("parseGradient simple", function()
		local result = parseGradient("linear-gradient(to right, #ff0000, #0000ff)")
		expect(result).toBeDefined()
		expect(result.rotation).toBe(0)
		expect(result.transparencySequence).toBeUndefined()
	end)
	it("parseGradient corners with size", function()
		local result = parseGradient("linear-gradient(to top right, red, blue)", 200, 100)
		expect(result).toBeDefined()
		-- atan2(200, 100) = ~63.43 -> rotation = 63.43 - 90 = -26.565
		expect(result.rotation).toBeCloseTo(-26.565, 2)
	end)
	it("parseGradient with transparency", function()
		local result = parseGradient("linear-gradient(to bottom, rgba(255, 0, 0, 0.5), rgba(0, 0, 255, 1))")
		expect(result).toBeDefined()
		expect(result.transparencySequence).toBeDefined()
	end)
	it("should return undefined for garbage input", function()
		expect(parseGradient("")).toBeUndefined()
		expect(parseGradient("banana")).toBeUndefined()
		expect(parseGradient("radial-gradient(red, blue)")).toBeUndefined()
		expect(parseGradient("linear-gradient()")).toBeUndefined()
		expect(parseGradient("linear-gradient(red)")).toBeUndefined()
	end)
	it("isGradientString rejects edge cases", function()
		expect(isGradientString("")).toBe(false)
		expect(isGradientString("LINEAR-GRADIENT(red, blue)")).toBe(false)
		expect(isGradientString("linear-gradient")).toBe(false)
	end)
	it("parseGradient three color stops", function()
		local result = parseGradient("linear-gradient(to right, #ff0000, #00ff00, #0000ff)")
		expect(result).toBeDefined()
		expect(result.rotation).toBe(0)
		expect(result.transparencySequence).toBeUndefined()
	end)
	it("parseGradient five color stops with explicit positions", function()
		local result = parseGradient("linear-gradient(to bottom, red 0%, orange 25%, yellow 50%, green 75%, blue 100%)")
		expect(result).toBeDefined()
		expect(result.rotation).toBe(90)
		expect(result.transparencySequence).toBeUndefined()
	end)
	it("parseGradient with turn unit", function()
		local result = parseGradient("linear-gradient(0.25turn, red, blue)")
		expect(result).toBeDefined()
		expect(result.rotation).toBe(0)
	end)
	it("parseGradient with rad unit", function()
		local result = parseGradient("linear-gradient(3.14159rad, red, blue)")
		expect(result).toBeDefined()
		expect(result.rotation).toBeCloseTo(90, 0)
	end)
	it("parseGradient corner keyword without dimensions defaults to 45deg", function()
		local result = parseGradient("linear-gradient(to top right, red, blue)")
		expect(result).toBeDefined()
		expect(result.rotation).toBe(-45)
	end)
	it("parseGradient with color hint", function()
		local result = parseGradient("linear-gradient(to right, red, 30%, blue)")
		expect(result).toBeDefined()
		expect(result.rotation).toBe(0)
		expect(#result.colorSequence.Keypoints).toBeGreaterThan(2)
	end)
	it("should return undefined for repeating-linear-gradient", function()
		expect(isGradientString("repeating-linear-gradient(red, blue)")).toBe(false)
		expect(parseGradient("repeating-linear-gradient(red, blue)")).toBeUndefined()
	end)
	it("gradient with 25 color stops downsamples to exactly 20 keypoints", function()
		local result = parseGradient("linear-gradient(to right, #000000, #111111, #222222, #333333, #444444, #555555, #666666, #777777, #888888, #999999, #aaaaaa, #bbbbbb, #cccccc, #dddddd, #eeeeee, #ffffff, #110000, #220000, #330000, #440000, #550000, #660000, #770000, #880000, #990000)")
		expect(result).toBeDefined()
		expect(#result.colorSequence.Keypoints).toBe(20)
	end)
	it("gradient with exactly 20 stops does not downsample", function()
		local result = parseGradient("linear-gradient(to right, #000000, #111111, #222222, #333333, #444444, #555555, #666666, #777777, #888888, #999999, #aaaaaa, #bbbbbb, #cccccc, #dddddd, #eeeeee, #ffffff, #110000, #220000, #330000, #440000)")
		expect(result).toBeDefined()
		expect(#result.colorSequence.Keypoints).toBe(20)
	end)
	it("gradient with 21 stops downsamples and preserves first and last keypoints", function()
		local result = parseGradient("linear-gradient(to right, #000000, #111111, #222222, #333333, #444444, #555555, #666666, #777777, #888888, #999999, #aaaaaa, #bbbbbb, #cccccc, #dddddd, #eeeeee, #ffffff, #110000, #220000, #330000, #440000, #550000)")
		expect(result).toBeDefined()
		expect(#result.colorSequence.Keypoints).toBe(20)
		expect(result.colorSequence.Keypoints[1].Time).toBe(0)
		expect(result.colorSequence.Keypoints[#result.colorSequence.Keypoints].Time).toBe(1)
	end)
end)
