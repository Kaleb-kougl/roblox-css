-- ── parsePadding ────────────────────────────────────────────────────
describe("parsePadding", function()
	-- ── Number input ────────────────────────────────────────────────
	describe("number input (uniform pixel padding)", function()
		it("should apply the same pixel UDim to all four sides", function()
			local result = parsePadding(20)
			expect(result.top.Scale).toBe(0)
			expect(result.top.Offset).toBe(20)
			expect(result.right.Scale).toBe(0)
			expect(result.right.Offset).toBe(20)
			expect(result.bottom.Scale).toBe(0)
			expect(result.bottom.Offset).toBe(20)
			expect(result.left.Scale).toBe(0)
			expect(result.left.Offset).toBe(20)
		end)
		it("should handle 0", function()
			local result = parsePadding(0)
			expect(result.top.Scale).toBe(0)
			expect(result.top.Offset).toBe(0)
			expect(result.right.Offset).toBe(0)
			expect(result.bottom.Offset).toBe(0)
			expect(result.left.Offset).toBe(0)
		end)
		it("should handle negative numbers", function()
			local result = parsePadding(-8)
			expect(result.top.Offset).toBe(-8)
			expect(result.right.Offset).toBe(-8)
			expect(result.bottom.Offset).toBe(-8)
			expect(result.left.Offset).toBe(-8)
		end)
	end)
	-- ── 1 value shorthand ───────────────────────────────────────────
	describe("1-value shorthand (all sides)", function()
		it("should parse '16px' to all sides", function()
			local result = parsePadding("16px")
			expect(result.top.Scale).toBe(0)
			expect(result.top.Offset).toBe(16)
			expect(result.right.Offset).toBe(16)
			expect(result.bottom.Offset).toBe(16)
			expect(result.left.Offset).toBe(16)
		end)
		it("should parse '50%' to all sides", function()
			local result = parsePadding("50%")
			expect(result.top.Scale).toBeCloseTo(0.5, 5)
			expect(result.top.Offset).toBe(0)
			expect(result.right.Scale).toBeCloseTo(0.5, 5)
			expect(result.bottom.Scale).toBeCloseTo(0.5, 5)
			expect(result.left.Scale).toBeCloseTo(0.5, 5)
		end)
		it("should parse '100vw' to all sides", function()
			local result = parsePadding("100vw")
			expect(result.top.Scale).toBeCloseTo(1, 5)
			expect(result.right.Scale).toBeCloseTo(1, 5)
			expect(result.bottom.Scale).toBeCloseTo(1, 5)
			expect(result.left.Scale).toBeCloseTo(1, 5)
		end)
	end)
	-- ── 2 value shorthand ───────────────────────────────────────────
	describe("2-value shorthand (vertical | horizontal)", function()
		it("should parse '10px 20px' → top/bottom=10, right/left=20", function()
			local result = parsePadding("10px 20px")
			expect(result.top.Offset).toBe(10)
			expect(result.right.Offset).toBe(20)
			expect(result.bottom.Offset).toBe(10)
			expect(result.left.Offset).toBe(20)
		end)
		it("should parse '25% 50%' → top/bottom=0.25, right/left=0.5", function()
			local result = parsePadding("25% 50%")
			expect(result.top.Scale).toBeCloseTo(0.25, 5)
			expect(result.right.Scale).toBeCloseTo(0.5, 5)
			expect(result.bottom.Scale).toBeCloseTo(0.25, 5)
			expect(result.left.Scale).toBeCloseTo(0.5, 5)
		end)
		it("should handle mixed units: '10px 50%'", function()
			local result = parsePadding("10px 50%")
			expect(result.top.Scale).toBe(0)
			expect(result.top.Offset).toBe(10)
			expect(result.right.Scale).toBeCloseTo(0.5, 5)
			expect(result.right.Offset).toBe(0)
			expect(result.bottom.Offset).toBe(10)
			expect(result.left.Scale).toBeCloseTo(0.5, 5)
		end)
	end)
	-- ── 3 value shorthand ───────────────────────────────────────────
	describe("3-value shorthand (top | horizontal | bottom)", function()
		it("should parse '10px 20px 30px' → top=10, right/left=20, bottom=30", function()
			local result = parsePadding("10px 20px 30px")
			expect(result.top.Offset).toBe(10)
			expect(result.right.Offset).toBe(20)
			expect(result.bottom.Offset).toBe(30)
			expect(result.left.Offset).toBe(20)
		end)
		it("should mirror horizontal to left: '5px 15px 25px'", function()
			local result = parsePadding("5px 15px 25px")
			expect(result.left.Offset).toBe(15)
			expect(result.right.Offset).toBe(15)
		end)
		it("should handle mixed units: '10% 20px 30%'", function()
			local result = parsePadding("10% 20px 30%")
			expect(result.top.Scale).toBeCloseTo(0.1, 5)
			expect(result.top.Offset).toBe(0)
			expect(result.right.Scale).toBe(0)
			expect(result.right.Offset).toBe(20)
			expect(result.bottom.Scale).toBeCloseTo(0.3, 5)
			expect(result.left.Offset).toBe(20)
		end)
	end)
	-- ── 4 value shorthand ───────────────────────────────────────────
	describe("4-value shorthand (top | right | bottom | left)", function()
		it("should parse '10px 20px 30px 40px' → clockwise assignment", function()
			local result = parsePadding("10px 20px 30px 40px")
			expect(result.top.Offset).toBe(10)
			expect(result.right.Offset).toBe(20)
			expect(result.bottom.Offset).toBe(30)
			expect(result.left.Offset).toBe(40)
		end)
		it("should handle all percent: '10% 20% 30% 40%'", function()
			local result = parsePadding("10% 20% 30% 40%")
			expect(result.top.Scale).toBeCloseTo(0.1, 5)
			expect(result.right.Scale).toBeCloseTo(0.2, 5)
			expect(result.bottom.Scale).toBeCloseTo(0.3, 5)
			expect(result.left.Scale).toBeCloseTo(0.4, 5)
		end)
		it("should handle mixed units: '10px 50% 20px 25vh'", function()
			local result = parsePadding("10px 50% 20px 25vh")
			expect(result.top.Scale).toBe(0)
			expect(result.top.Offset).toBe(10)
			expect(result.right.Scale).toBeCloseTo(0.5, 5)
			expect(result.right.Offset).toBe(0)
			expect(result.bottom.Offset).toBe(20)
			expect(result.left.Scale).toBeCloseTo(0.25, 5)
		end)
		it("should assign each side independently (no shared references)", function()
			local result = parsePadding("1px 2px 3px 4px")
			expect(result.top.Offset).toBe(1)
			expect(result.right.Offset).toBe(2)
			expect(result.bottom.Offset).toBe(3)
			expect(result.left.Offset).toBe(4)
		end)
	end)
	-- ── Auto token handling ─────────────────────────────────────────
	describe("auto token handling", function()
		it("should fall back to zero padding when 'auto' is used alone", function()
			local result = parsePadding("auto")
			expect(result.top.Scale).toBe(0)
			expect(result.top.Offset).toBe(0)
			expect(result.right.Scale).toBe(0)
			expect(result.right.Offset).toBe(0)
			expect(result.bottom.Scale).toBe(0)
			expect(result.bottom.Offset).toBe(0)
			expect(result.left.Scale).toBe(0)
			expect(result.left.Offset).toBe(0)
		end)
		it("should fall back to zero padding when 'auto' appears in multi-value shorthand", function()
			local result = parsePadding("10px auto")
			expect(result.top.Scale).toBe(0)
			expect(result.top.Offset).toBe(0)
		end)
	end)
	-- ── Fallback (invalid input) ────────────────────────────────────
	describe("fallback (invalid input)", function()
		it("should return zero UDim padding for unrecognized string", function()
			local result = parsePadding("banana")
			expect(result.top.Scale).toBe(0)
			expect(result.top.Offset).toBe(0)
			expect(result.right.Scale).toBe(0)
			expect(result.right.Offset).toBe(0)
		end)
		it("should return zero UDim padding for too many values", function()
			local result = parsePadding("1px 2px 3px 4px 5px")
			expect(result.top.Scale).toBe(0)
			expect(result.top.Offset).toBe(0)
		end)
		it("should return zero UDim padding for empty string", function()
			local result = parsePadding("")
			expect(result.top.Scale).toBe(0)
			expect(result.top.Offset).toBe(0)
		end)
	end)
end)
