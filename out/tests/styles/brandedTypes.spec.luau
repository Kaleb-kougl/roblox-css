--[[
	*
	 * Tests for branded type helpers and branded object guarantees.
	 *
	 * Branded types use `& { readonly _parsed: unique symbol }` to prevent
	 * accidental construction of ParsedColor / PaddingValues outside of
	 * their respective helper functions. The brand is a compile-time guard
	 * (unique symbol erases at runtime), so these tests verify:
	 *
	 *   1. Helper functions produce objects with the correct fields and values
	 *   2. Return values from public parse functions are structurally correct
	 *   3. Field values survive the as-any-as cast without corruption
	 
]]
-- ── Module imports via dynamic require ──────────────────────────────
local robloxCSS = game:GetService("ReplicatedStorage"):WaitForChild("roblox-css")
local uiStyles = robloxCSS:WaitForChild("styles")
local colorParserModule = require(uiStyles:WaitForChild("colorParser"))
local parseColor = colorParserModule.parseColor
local dimensionParserModule = require(uiStyles:WaitForChild("dimensionParser"))
local parseDimension = dimensionParserModule.parseDimension
local parsePadding = dimensionParserModule.parsePadding
-- ── ParsedDimension branded type tests ─────────────────────────────
describe("ParsedDimension (branded type)", function()
	describe("structure", function()
		it("should return a value that is a UDim", function()
			local result = parseDimension(100)
			expect(result).toBeDefined()
			expect(typeof(result) == "UDim").toBe(true)
		end)
		it("should have Scale and Offset fields", function()
			local result = parseDimension(42)
			expect(result).toBeDefined()
			local _scale = result.Scale
			expect(type(_scale) == "number").toBe(true)
			local _offset = result.Offset
			expect(type(_offset) == "number").toBe(true)
		end)
		it("should not have a runtime _parsed field (brand erases)", function()
			local result = parseDimension(10)
			-- UDim is Roblox userdata — accessing an invalid member throws
			-- rather than returning nil. The brand is compile-time only,
			-- so attempting to read "_parsed" must error at runtime.
			local ok = pcall(function()
				return result._parsed
			end)
			expect(ok).toBe(false)
		end)
	end)
	describe("helper produces correct values through the cast", function()
		it("should preserve pixel values: number → UDim(0, n)", function()
			local result = parseDimension(200)
			expect(result).toBeDefined()
			expect(result.Scale).toBe(0)
			expect(result.Offset).toBe(200)
		end)
		it("should preserve percent values: '75%' → UDim(0.75, 0)", function()
			local result = parseDimension("75%")
			expect(result).toBeDefined()
			expect(result.Scale).toBeCloseTo(0.75, 5)
			expect(result.Offset).toBe(0)
		end)
		it("should preserve pixel string values: '60px' → UDim(0, 60)", function()
			local result = parseDimension("60px")
			expect(result).toBeDefined()
			expect(result.Scale).toBe(0)
			expect(result.Offset).toBe(60)
		end)
		it("should preserve viewport values: '50vw' → UDim(0.5, 0)", function()
			local result = parseDimension("50vw")
			expect(result).toBeDefined()
			expect(result.Scale).toBeCloseTo(0.5, 5)
			expect(result.Offset).toBe(0)
		end)
		it("should preserve zero through the cast", function()
			local result = parseDimension(0)
			expect(result).toBeDefined()
			expect(result.Scale).toBe(0)
			expect(result.Offset).toBe(0)
		end)
		it("should preserve negative values through the cast", function()
			local result = parseDimension(-25)
			expect(result).toBeDefined()
			expect(result.Scale).toBe(0)
			expect(result.Offset).toBe(-25)
		end)
	end)
	describe("auto returns undefined (no branded value)", function()
		it("should return undefined for 'auto'", function()
			local result = parseDimension("auto")
			expect(result).toBeUndefined()
		end)
	end)
	describe("fallback produces branded value", function()
		it("should return a branded UDim(0, 0) for unrecognized input", function()
			local result = parseDimension("banana")
			expect(result).toBeDefined()
			expect(typeof(result) == "UDim").toBe(true)
			expect(result.Scale).toBe(0)
			expect(result.Offset).toBe(0)
		end)
	end)
	describe("distinct instances (no shared state)", function()
		it("should produce distinct UDim instances for each call", function()
			local a = parseDimension(10)
			local b = parseDimension(20)
			expect(a).toBeDefined()
			expect(b).toBeDefined()
			expect(a).never.toBe(b)
		end)
		it("should produce distinct instances even with same input", function()
			local a = parseDimension(100)
			local b = parseDimension(100)
			expect(a).toBeDefined()
			expect(b).toBeDefined()
			-- UDim values are equal but should be separate allocations
			expect(a.Scale).toBe(b.Scale)
			expect(a.Offset).toBe(b.Offset)
		end)
	end)
end)
-- ── ParsedColor branded type tests ──────────────────────────────────
describe("ParsedColor (branded type)", function()
	describe("structure", function()
		it("should have a 'color' field that is a Color3", function()
			local result = parseColor("#ff0000")
			local _color = result.color
			expect(typeof(_color) == "Color3").toBe(true)
		end)
		it("should have a 'transparent' field that is a boolean", function()
			local result = parseColor("#ff0000")
			local _transparent = result.transparent
			expect(type(_transparent) == "boolean").toBe(true)
		end)
		it("should only contain color and transparent fields", function()
			local result = parseColor("red")
			local keys = {}
			for key in pairs(result) do
				table.insert(keys, key)
			end
			-- Should have exactly 3 keys (color, transparent, and transparency)
			-- The _parsed brand symbol does NOT exist at runtime
			expect(#keys).toBe(3)
			expect(table.find(keys, "color") ~= nil).toBe(true)
			expect(table.find(keys, "transparent") ~= nil).toBe(true)
			expect(table.find(keys, "transparency") ~= nil).toBe(true)
		end)
	end)
	describe("helper produces correct values through the cast", function()
		it("should preserve Color3 values through as-any-as cast", function()
			local result = parseColor("#ff8800")
			local expected = Color3.fromRGB(255, 136, 0)
			expect(result.color.R).toBeCloseTo(expected.R, 3)
			expect(result.color.G).toBeCloseTo(expected.G, 3)
			expect(result.color.B).toBeCloseTo(expected.B, 3)
		end)
		it("should preserve transparent=false through the cast", function()
			local result = parseColor("#000000")
			expect(result.transparent).toBe(false)
		end)
		it("should preserve transparent=true through the cast", function()
			local result = parseColor("transparent")
			expect(result.transparent).toBe(true)
		end)
		it("should produce distinct objects for each call (no shared state)", function()
			local a = parseColor("red")
			local b = parseColor("blue")
			expect(a).never.toBe(b)
			expect(a.color).never.toBe(b.color)
		end)
	end)
	describe("Color3 pass-through preserves identity", function()
		it("should return the exact same Color3 instance (no clone)", function()
			local input = Color3.fromRGB(42, 42, 42)
			local result = parseColor(input)
			-- The helper wraps it but should keep the same Color3 reference
			expect(result.color).toBe(input)
		end)
	end)
end)
