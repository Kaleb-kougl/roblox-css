describe("colorParser", function()
	-- ── Color3 pass-through ──────────────────────────────────────────
	describe("Color3 pass-through", function()
		it("should return the same Color3 instance unchanged", function()
			local input = Color3.fromRGB(123, 45, 67)
			local result = parseColor(input)
			expect(result.color).toBe(input)
			expect(result.transparent).toBe(false)
			expect(result.transparency).toBe(0)
		end)
		it("should handle Color3(0, 0, 0) (black)", function()
			local input = Color3.new(0, 0, 0)
			local result = parseColor(input)
			expect(result.color).toBe(input)
			expect(result.transparent).toBe(false)
			expect(result.transparency).toBe(0)
		end)
		it("should handle Color3(1, 1, 1) (white)", function()
			local input = Color3.new(1, 1, 1)
			local result = parseColor(input)
			expect(result.color).toBe(input)
			expect(result.transparent).toBe(false)
			expect(result.transparency).toBe(0)
		end)
	end)
	-- ── Transparent keyword ──────────────────────────────────────────
	describe("transparent keyword", function()
		it("should return white with transparent: true", function()
			local result = parseColor("transparent")
			expect(result.color.R).toBe(1)
			expect(result.color.G).toBe(1)
			expect(result.color.B).toBe(1)
			expect(result.transparent).toBe(true)
			expect(result.transparency).toBe(1)
		end)
		it("should not match 'Transparent' (case-sensitive)", function()
			-- "Transparent" with capital T falls through to named color lookup,
			-- which lowercases it. "transparent" is not in NAMED_COLORS,
			-- so it hits the fallback path.
			local result = parseColor("Transparent")
			-- Should hit fallback (warn + white), NOT the transparent branch
			expect(result.transparent).toBe(false)
			expect(result.transparency).toBe(0)
		end)
	end)
